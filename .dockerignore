# Dependencies (bare patterns only match root in Docker — use **/ for nested)
**/node_modules
**/.pnpm-store

# Build outputs (any depth — apps/web/.next was leaking 1.8GB into context)
**/.next
**/dist
server/bin
server/tmp
# `go build ./cmd/server` from server/ drops the binary here (gitignored, but
# .gitignore does not apply to a Docker context) — 49MB re-uploaded every deploy.
server/server

# Agent + task-runner scratch. `.claude/` holds worktrees and transcripts and was
# measured at 217MB of context on a real deploy; `.turbo/` is a local task cache.
# Neither is ever read by an image build.
.claude/
.turbo/

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
docs/

# Desktop app (not needed for web self-hosting)
apps/desktop

# Other apps not needed for web/backend image builds
# (apps/docs stays IN the context — Dockerfile.docs builds from it)
apps/mobile

# Compiled binaries (root) — build artifacts, rebuilt inside the image
bin/

# Tooling artifacts + TS incremental cache (never needed in a build)
.playwright-mcp/
**/*.tsbuildinfo
