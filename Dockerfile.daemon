# Always-on Agora daemon (cloud node) for Fly.io.
#
# Runs `agora daemon` 24/7 so a workspace's agents execute even when the
# owner's laptop is off/asleep. Authenticates to the backend with a user PAT
# (mul_...) and runs Claude Code as the agent runtime (BYO key via
# ANTHROPIC_API_KEY, or a `claude setup-token` OAuth token in
# CLAUDE_CODE_OAUTH_TOKEN).
#
# Build context MUST be the repo root (the builder copies server/):
#   fly deploy --config deploy/fly/daemon/fly.toml --dockerfile Dockerfile.daemon .

# --- Build stage: agora CLI ---
FROM golang:1.26-alpine AS builder
RUN apk add --no-cache git
WORKDIR /src
COPY server/go.mod server/go.sum ./server/
RUN cd server && go mod download
COPY server/ ./server/
ARG VERSION=daemon
ARG COMMIT=unknown
RUN cd server && CGO_ENABLED=0 go build \
      -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o bin/agora ./cmd/agora

# --- Runtime stage: Node + Claude Code + agora daemon ---
FROM node:22-bookworm-slim

# git: the daemon clones repos / manages worktrees for code tasks.
# openssh-client: clone/push private repos over SSH (self-hosted GitLab,
# private GitHub) using a key provisioned by the entrypoint from DAEMON_SSH_KEY.
# ripgrep: Claude Code's file search. ca-certificates: outbound TLS.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates ripgrep curl \
    && rm -rf /var/lib/apt/lists/*

# Claude Code CLI — the agent runtime the daemon spawns once per task.
RUN npm install -g @anthropic-ai/claude-code

# Feishu/Lark OpenAPI MCP — pre-installed so agents with a Lark Bot bound get
# the lark_* tools (messages, docs, calendar, Bitable) without a cold npx fetch
# on first use. Credentials are injected per task via the MCP server's env
# (APP_ID/APP_SECRET/LARK_DOMAIN), never baked into the image.
RUN npm install -g @larksuiteoapi/lark-mcp

# Framelink Figma MCP — pre-installed (pinned; keep in sync with
# figmaMcpVersion in server/internal/handler/figma_mcp.go and the preset in
# packages/core/mcp/types.ts) so agents whose issues reference Figma designs
# get get_figma_data/download_figma_images without a cold npx fetch. The
# FIGMA_API_KEY is injected per task from the workspace credential, never
# baked into the image.
RUN npm install -g figma-developer-mcp@0.13.2

# code-server (browser VS Code) — the daemon spawns it on demand for the live
# "Code" editor so a human can watch + edit an agent's worktree from the browser.
RUN curl -fsSL https://code-server.dev/install.sh | sh

COPY --from=builder /src/server/bin/agora /usr/local/bin/agora
COPY deploy/fly/daemon/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# HOME lives on the mounted volume so the agora config (~/.agora/config.json),
# the Claude config (~/.claude), and the cloned workspaces all survive restarts.
ENV HOME=/data
WORKDIR /data
ENTRYPOINT ["/entrypoint.sh"]
