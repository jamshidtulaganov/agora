# Telegram Mini App (apps/telegram) — static Vite SPA served by nginx, which
# also reverse-proxies /api /ws /auth /uploads to the private Go backend.
# Build context MUST be the repo root (needs the pnpm workspace + shared packages).
#
#   fly deploy --config deploy/fly/telegram/fly.toml --dockerfile Dockerfile.telegram .

# --- Dependencies ---
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/telegram/package.json apps/telegram/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/views/package.json packages/views/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/

RUN pnpm install --frozen-lockfile

# --- Build ---
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
WORKDIR /app

COPY --from=deps /app ./
COPY package.json turbo.json pnpm-workspace.yaml ./
COPY apps/telegram/ apps/telegram/
COPY packages/ packages/

# Re-link after the source overlay (restores any symlinks COPY clobbered).
RUN pnpm install --frozen-lockfile --offline
RUN pnpm --filter @agora/telegram build

# --- Runtime (nginx) ---
FROM nginx:1.27-alpine AS runner
COPY deploy/fly/telegram/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/telegram/dist /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
