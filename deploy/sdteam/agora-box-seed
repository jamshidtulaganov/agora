#!/usr/bin/env bash
# agora-box-seed <subdomain> [--dry-run]
#
# The sdteam "dbt_ clone" process, automated. Gives a per-developer QA box its
# OWN test database as a fresh clone of the golden seed (dbt_agora @
# /var/www/agora.sdteam.uz) and points the site's config at it:
#
#   jamshid.sdteam.uz  →  dbt_jamshid   (created/refreshed from dbt_agora)
#
# Re-running refreshes the clone (drop+recreate tables from the seed dump).
# Credentials are read from each site's own Yii main.php ON THIS HOST and are
# never printed. Triggered by Agora's POST /api/remote-boxes/{id}/seed
# (AGORA_QA_BOX_SEED_COMMAND='~/bin/agora-box-seed {subdomain}') or by hand.
#
# Safety rails:
#   - derived target db is always dbt_<handle>; anything not dbt_* is refused
#   - the golden seed (dbt_agora) and the seed site are never written
#   - config rewrite touches ONLY the dbname= inside connectionString, with a
#     one-time .bak-agora backup next to main.php
set -euo pipefail

SEED_SITE="/var/www/agora.sdteam.uz"
SEED_DB_EXPECT="dbt_agora"
WEB_ROOT="/var/www"

sub="${1:-}"; shift || true
dry=0
[ "${1:-}" = "--dry-run" ] && dry=1
if [ -z "$sub" ]; then echo "usage: agora-box-seed <subdomain> [--dry-run]" >&2; exit 2; fi

target_dir="$WEB_ROOT/$sub"
cfg="$target_dir/protected/config/main.php"
[ -d "$target_dir" ] || { echo "ERROR: $target_dir does not exist" >&2; exit 2; }
[ -f "$cfg" ] || { echo "ERROR: $cfg not found" >&2; exit 2; }
[ "$target_dir" != "$SEED_SITE" ] || { echo "ERROR: refusing to seed the seed site itself" >&2; exit 2; }

handle="${sub%%.*}"
case "$handle" in
  ""|*[!a-zA-Z0-9_-]*) echo "ERROR: cannot derive a db handle from '$sub'" >&2; exit 2;;
esac
target_db="dbt_$(echo "$handle" | tr '-' '_')"
case "$target_db" in dbt_*) ;; *) echo "ERROR: derived db '$target_db' is not dbt_* — refusing" >&2; exit 4;; esac
[ "$target_db" != "$SEED_DB_EXPECT" ] || { echo "ERROR: derived db equals the golden seed — refusing" >&2; exit 4; }

# read_db <site_dir> <field> — extracts db config from the site's Yii main.php
# without echoing secrets (values land only in this process's variables).
read_db() {
  php -r '
    $t = file_get_contents($argv[1] . "/protected/config/main.php");
    if ($t === false) { fwrite(STDERR, "config unreadable\n"); exit(3); }
    $pos = strpos($t, "connectionString");
    if ($pos === false) { fwrite(STDERR, "no connectionString\n"); exit(3); }
    $win = substr($t, $pos, 600);
    $get = function($re) use ($win) { return preg_match($re, $win, $m) ? $m[1] : ""; };
    preg_match("/dbname=([^;\x27\"]+)/", $win, $m);
    $vals = [
      "dbname" => $m[1] ?? "",
      "host"   => ($get("/host=([^;\x27\"]+)/") ?: "127.0.0.1"),
      "user"   => $get("/[\x27\"]username[\x27\"]\s*=>\s*[\x27\"]([^\x27\"]*)[\x27\"]/"),
      "pass"   => $get("/[\x27\"]password[\x27\"]\s*=>\s*[\x27\"]([^\x27\"]*)[\x27\"]/"),
    ];
    echo $vals[$argv[2]];
  ' "$1" "$2"
}

s_db="$(read_db "$SEED_SITE" dbname)"
s_host="$(read_db "$SEED_SITE" host)"
s_user="$(read_db "$SEED_SITE" user)"
s_pass="$(read_db "$SEED_SITE" pass)"
[ "$s_db" = "$SEED_DB_EXPECT" ] || { echo "ERROR: seed site resolves to '$s_db', expected $SEED_DB_EXPECT — layout changed, refusing" >&2; exit 4; }

cur_db="$(read_db "$target_dir" dbname)"
echo "seed: $s_db → $target_db (site $sub, current config db: $cur_db)"
if [ "$dry" = "1" ]; then
  [ "$cur_db" = "$target_db" ] || echo "dry-run: would repoint $cfg dbname=$cur_db → dbname=$target_db (backup: main.php.bak-agora)"
  echo "dry-run: would CREATE DATABASE IF NOT EXISTS $target_db and refresh it from $s_db; no data touched"
  exit 0
fi

started=$(date +%s)
# Charset/collation copied from the golden seed so the clone behaves identically.
cs_line="$(MYSQL_PWD="$s_pass" mysql -h "$s_host" -u "$s_user" -N -e \
  "SELECT DEFAULT_CHARACTER_SET_NAME, DEFAULT_COLLATION_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$s_db'")"
cs_name="$(echo "$cs_line" | awk '{print $1}')"; cs_coll="$(echo "$cs_line" | awk '{print $2}')"
MYSQL_PWD="$s_pass" mysql -h "$s_host" -u "$s_user" -e \
  "CREATE DATABASE IF NOT EXISTS \`$target_db\` CHARACTER SET ${cs_name:-utf8} COLLATE ${cs_coll:-utf8_general_ci}"

MYSQL_PWD="$s_pass" mysqldump -h "$s_host" -u "$s_user" \
    --single-transaction --quick --add-drop-table --routines --triggers "$s_db" \
  | MYSQL_PWD="$s_pass" mysql -h "$s_host" -u "$s_user" "$target_db"

if [ "$cur_db" != "$target_db" ]; then
  [ -f "$cfg.bak-agora" ] || cp "$cfg" "$cfg.bak-agora"
  # Rewrite ONLY the dbname= token inside the connection string.
  sed -i "s/dbname=$cur_db/dbname=$target_db/" "$cfg"
  echo "config: $sub now points at $target_db (was $cur_db; backup main.php.bak-agora)"
fi

tables="$(MYSQL_PWD="$s_pass" mysql -h "$s_host" -u "$s_user" -N -e \
  "SELECT count(*) FROM information_schema.tables WHERE table_schema='$target_db'")"
echo "SEED_OK $target_db tables=$tables in $(( $(date +%s) - started ))s"
