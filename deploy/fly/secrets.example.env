# Copy to deploy/fly/secrets.env (gitignored) and fill in. Consumed by deploy.sh.
# These become `fly secrets` on agora-db / agora-backend — never committed.

# Postgres superuser password for agora-db.
POSTGRES_PASSWORD=change-me-strong

# Backend JWT signing secret. Generate: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# Gmail SMTP app password (16 chars, spaces ok). From the Google account that
# sends login codes / invitations.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Google OAuth client secret (GOCSPX-...). Pairs with GOOGLE_CLIENT_ID in
# backend/fly.toml. Add https://agora-web.fly.dev/auth/callback as an authorized
# redirect URI (and https://agora-web.fly.dev as a JS origin) in Google Console.
GOOGLE_CLIENT_SECRET=GOCSPX-change-me

# Telegram bot (PM bot) token from @BotFather. Powers bot-OTP login, the Mini
# App initData HMAC, and push DMs.
TELEGRAM_BOT_TOKEN=123456:change-me
# Optional secret_token registered with the webhook (validated on /telegram/webhook).
TELEGRAM_WEBHOOK_SECRET=change-me-optional
# Telegram Mini App short name (@BotFather → /newapp). Used to build
# https://t.me/<bot>/<shortname>?startapp=... deep links for push DMs. Leave
# blank until the Mini App is registered, then re-run: deploy.sh backend.
TELEGRAM_MINIAPP_SHORTNAME=
